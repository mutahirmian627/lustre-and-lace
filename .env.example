# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Resend (transactional email) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a domain verified in the Resend dashboard before launch.
# For local testing: "Lustre & Lace <onboarding@resend.dev>" (delivers only to your own Resend account email).
FROM_EMAIL="orders@example.lustreandlace.com"

# No domain? Send through any mailbox instead (e.g. Gmail with an app password); leave blank to use Resend.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="your-16-char-app-password"
# (set FROM_EMAIL="Lustre & Lace <you@gmail.com>" to match)

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Cron (Vercel Cron auth for the auto-cancel-unpaid-orders route) ---
CRON_SECRET="replace-with-a-generated-secret"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Bootstrap admin (db/seed.ts) --- change the password after first login
ADMIN_EMAIL="admin@lustreandlace.com"
ADMIN_PASSWORD="change-this-password-1"

# --- Super admin (db/seed.ts) --- the only account that can promote admins; use 12+ characters
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD=""
